# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/metro_pway?retryWrites=true&w=majority

# Strong random secret for JWT signing. Keep this private.
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

# CORS: put the exact deployed frontend URL here.
# For local testing:
FRONTEND_ORIGIN=http://localhost:5173

# First-run defaults. Change these before production.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD
DEFAULT_RECOVERY_CODE=CHANGE_THIS_RECOVERY_CODE

# Optional key reserved for future one-time migration tooling.
MIGRATION_KEY=CHANGE_THIS_MIGRATION_KEY

PORT=5000
